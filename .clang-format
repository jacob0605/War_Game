Language: Cpp
BasedOnStyle: LLVM # Google 스타일을 기반으로 설정
IndentWidth: 4 # 들여쓰기 크기 설정 (4 공백)
TabWidth: 4 # 탭 크기 설정 (4 공백 크기만큼)
UseTab: Always # 탭을 사용하여 들여쓰기
ColumnLimit: 0 # 한 줄 최대 길이를 120자로 설정
BraceWrapping:
    AfterControlStatement: true # if, for, while 등의 제어문에서 중괄호를 옆에 배치
    AfterFunction: false # 함수 선언 후 중괄호를 옆에 배치
    AfterClass: true # 클래스 선언 후 중괄호를 옆에 배치
    AfterEnum: true # 열거형 선언 후 중괄호를 옆에 배치
    AfterStruct: true # 구조체 선언 후 중괄호를 옆에 배치
    SplitEmptyFunction: false # 빈 함수에서 중괄호를 한 줄로 작성
PointerAlignment: Left  # 포인터(*)와 참조(&)를 왼쪽에 배치 (예시: int32* temp;)
AlignTrailingComments: true 
# 접근 제어자 위치 설정
AccessModifierOffset: -4  # public, private, protected 등을 클래스/구조체의 맨 앞에 배치하도록 설정